<!-- Projet d'essai du prototype n° 1 de Vision (mission 004) : sans couche, en Lambert 93,
     portant la variable de projet vision_id (UUID tiré une fois, le 2 novembre 2026).
     Écrit à la main : à ouvrir d'abord dans QGIS (Propriétés du projet, onglet Variables). -->
<qgis projectname="vision-essai" version="3.40.0-Bratislava">
  <homePath path=""/>
  <title>vision-essai</title>
  <projectCrs>
    <spatialrefsys nativeFormat="Wkt">
      <authid>EPSG:2154</authid>
    </spatialrefsys>
  </projectCrs>
  <layer-tree-group/>
  <properties>
    <Variables>
      <variableNames type="QStringList">
        <value>vision_id</value>
      </variableNames>
      <variableValues type="QStringList">
        <value>936eb144-5447-4094-a579-fac12a9f0595</value>
      </variableValues>
    </Variables>
  </properties>
</qgis>
